# android or ios
PLATFORM=android

# Required by Appium. Set this to the root of an installed JDK.
JAVA_HOME=C:\Program Files\Java\jdk-21

# Android physical-device configuration
ANDROID_DEVICE_NAME=Android Device
ANDROID_UDID=
ANDROID_PLATFORM_VERSION=
ANDROID_APP_PATH=apps/android.wdio.native.app.apk

# Optional iOS simulator configuration
IOS_DEVICE_NAME=iPhone 17
IOS_PLATFORM_VERSION=
IOS_APP_PATH=apps/ios.simulator.wdio.native.app.app

# Appium server settings
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Restful Booker
API_BASE_URL=https://restful-booker.herokuapp.com
